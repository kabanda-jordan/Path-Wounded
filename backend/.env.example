# ─── Database ──────────────────────────────────────────────────
# Local dev:  postgresql://user:pass@localhost:5432/path_wounded?schema=public
# Supabase:   pooled     = postgresql://postgres.[ref]:[pass]@aws-0-[region].pooler.supabase.com:6543/postgres
#             direct     = postgresql://postgres.[ref]:[pass]@aws-0-[region].pooler.supabase.com:5432/postgres
DATABASE_URL=""
DIRECT_URL=""

# ─── JWT ───────────────────────────────────────────────────────
JWT_ACCESS_SECRET=""
JWT_REFRESH_SECRET=""
JWT_ACCESS_EXPIRY="15m"
JWT_REFRESH_EXPIRY="30d"

# ─── SMTP (email) ─────────────────────────────────────────────
SMTP_HOST="smtp.ethereal.email"
SMTP_PORT=587
SMTP_USER=""
SMTP_PASS=""
EMAIL_FROM="noreply@pathwounded.com"

# ─── S3 (file uploads) ────────────────────────────────────────
S3_ENDPOINT=""
S3_BUCKET=""
S3_ACCESS_KEY=""
S3_SECRET_KEY=""
S3_REGION="us-east-1"

# ─── Redis (optional — falls back to in-memory if not set) ────
REDIS_URL=""

# ─── Server ────────────────────────────────────────────────────
PORT=3000
NODE_ENV="development"

# ─── CORS ──────────────────────────────────────────────────────
# Comma-separated list of allowed origins.
# In production set to your Vercel URL, e.g.:
#   CORS_ORIGIN="https://path-wounded.vercel.app"
CORS_ORIGIN="http://localhost:5173"
